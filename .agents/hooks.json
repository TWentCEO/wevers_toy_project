{
  "learning-guard-hook": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/learning_guard_hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
